$capability = Get-WindowsCapability -Online | Where-Object Name -like 'OpenSSH.Server*'
if ($capability.State -ne 'Installed') { Add-WindowsCapability -Online -Name $capability.Name }

Stop-Service sshd -ErrorAction SilentlyContinue

$configPath = 'C:\ProgramData\ssh\sshd_config'
(Get-Content $configPath) -replace 'Match Group administrators', 'Match Group *S-1-5-32-544' -replace 'Match Group Administradores', 'Match Group *S-1-5-32-544' | Set-Content $configPath

$pubKey = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC7utCTcCByWbIwkETA+TZj1o4nNtrob4SZNvSosVaS7 mi-pc'
$authKeysPath = 'C:\ProgramData\ssh\administrators_authorized_keys'
Set-Content -Path $authKeysPath -Value $pubKey -Encoding ASCII -Force

takeown /F $authKeysPath /A | Out-Null
icacls $authKeysPath /inheritance:r | Out-Null
icacls $authKeysPath /grant '*S-1-5-32-544:F' | Out-Null
icacls $authKeysPath /grant 'SYSTEM:F' | Out-Null
icacls $authKeysPath /setowner '*S-1-5-32-544' | Out-Null

if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'OpenSSH-ServeSSH Server (sshd)' -Enabled True -DirectionInbound -Protocol TCP -Action Allow -LocalPort 22 | Out-Null
}

Set-Service -Name sshd -StartupType Automatic
Start-Service sshd

Unregister-ScheduledTask -TaskName 'SshdDeburAction SilentlyContinue

Write-Host "=== VERIFICACION ==="
Select-String -Path $configPath -Pattern 'Match Group'
icacls $authKeysPath
Get-Service sshd
