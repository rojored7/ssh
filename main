$capability = Get-WindowsCapability -Online | Where-Object Name -like 'OpenSSH.Server*'
if ($capability.State -ne 'Installed') { Add-WindowsCapability -Online -Name $capability.Name }
Start-Service sshd
Set-Service -Name sshd -StartupType Automatic
if (-not (Get-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -Name 'OpenSSH-Server-In-TCP' -DisplayName 'OpenSSH Server (sshd)' -Enabled True -Direction Inbound -Protocol TCP -Action Allow -LocalPort 22
}
$pubKey = 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIC7utCTcCByWbIwkETA+TZj1o4nNtrob4SZNvSosVaS7 mi-pc'
$authKeysPath = 'C:\ProgramData\ssh\administrators_authorized_keys'
Set-Content -Path $authKeysPath -Value $pubKey -Encoding ASCII -Force
icacls $authKeysPath /inheritance:r
icacls $authKeysPath /grant 'Administrators:F'
icacls $authKeysPath /grant 'SYSTEM:F'
Restart-Service sshd
Get-Service sshd
